<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PrefsLib.Dialog.RootScroller"
    tools:theme="@style/Theme.Material3Expressive.DayNight.Dialog.Alert">

    <LinearLayout
        style="@style/PrefsLib.Dialog.Container"
        android:orientation="vertical">

        <TextView
            android:id="@+id/message"
            style="@style/PrefsLib.Dialog.Message"
            android:visibility="gone"
            tools:text="Optional message"
            tools:visibility="visible" />

        <RadioGroup
            android:id="@+id/settings"
            style="@style/PrefsLib.Dialog.Settings">

        </RadioGroup>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>