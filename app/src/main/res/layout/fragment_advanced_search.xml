<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ns_content_body"
    style="@style/FragmentRoot.NestedScroller"
    tools:context=".FragmentHostActivity"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_body"
        style="@style/FragmentRoot.ConstraintLayout"
        >

        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/inputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="lbl_author,lbl_title,lbl_series,lbl_publisher,lbl_keywords"
            app:flow_horizontalAlign="start"
            app:flow_horizontalGap="@dimen/field_margin_inline"
            app:flow_horizontalStyle="spread"
            app:flow_verticalBias="0"
            app:flow_verticalGap="@dimen/field_margin_top"
            app:flow_verticalStyle="packed"
            app:flow_wrapMode="aligned"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lbl_author"
            style="@style/TIL.Text.FtsInput"
            android:hint="@string/lbl_author"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/author"
                style="@style/TIE.Generic"
                android:imeOptions="actionDone"
                android:inputType="textMultiLine"
                tools:ignore="Autofill"
                />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lbl_title"
            style="@style/TIL.Text.FtsInput"
            android:hint="@string/lbl_title"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/title"
                style="@style/TIE.Generic"
                android:imeOptions="actionDone"
                android:inputType="textMultiLine"
                tools:ignore="Autofill"
                />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lbl_series"
            style="@style/TIL.Text.FtsInput"
            android:hint="@string/lbl_series"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/series_title"
                style="@style/TIE.Generic"
                android:imeOptions="actionDone"
                android:inputType="textMultiLine"
                tools:ignore="Autofill"
                />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lbl_publisher"
            style="@style/TIL.Text.FtsInput"
            android:hint="@string/lbl_publisher"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/publisher"
                style="@style/TIE.Generic"
                android:imeOptions="actionDone"
                android:inputType="textMultiLine"
                tools:ignore="Autofill"
                />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lbl_keywords"
            style="@style/TIL.Text.FtsInput"
            android:hint="@string/lbl_keywords"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/keywords"
                style="@style/TIE.Generic"
                android:imeOptions="actionDone"
                android:inputType="textMultiLine"
                tools:ignore="Autofill"
                />

        </com.google.android.material.textfield.TextInputLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_results"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/field_margin_start"
            android:layout_marginEnd="@dimen/field_margin_end"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inputs"
            app:layout_constraintWidth_max="@dimen/centered_max_width"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>