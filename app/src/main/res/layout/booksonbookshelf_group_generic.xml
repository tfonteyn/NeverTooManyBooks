<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    tools:viewBindingIgnore="true">

    <TextView
        android:id="@+id/level_text"
        style="@style/BoB.Group.Label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="Level" />

    <TextView
        android:id="@+id/level_book_count"
        style="@style/BoB.Group.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/field_margin_start"
        android:layout_marginEnd="@dimen/field_margin_start"
        tools:text="#34" />

    <!-- uses visibility="invisible" to preserve the space,
         even when it's not used by the row. -->
    <ImageView
        android:id="@+id/cbx_is_complete"
        style="@style/Flag.Complete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        tools:ignore="ContentDescription"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ROW_MENU_BTN"
        style="@style/Button.MenuPopup.More"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
