<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/FragmentRoot.ConstraintLayout"
    tools:context=".FragmentHostActivity"
    >

    <ImageView
        android:id="@+id/app_icon"
        style="@style/About.AppIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/app_name"
        style="@style/About.AppName"
        app:layout_constraintBottom_toBottomOf="@id/app_icon"
        app:layout_constraintStart_toEndOf="@id/app_icon"
        app:layout_constraintTop_toTopOf="@id/app_icon"
        tools:text="NeverTooManyBooks"
        />

    <TextView
        android:id="@+id/version"
        style="@style/About.Version"
        android:textIsSelectable="true"
        app:layout_constraintEnd_toEndOf="@id/app_name"
        app:layout_constraintTop_toBottomOf="@id/app_name"
        tools:text="x.y.z"
        />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_header_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="app_icon,version"
        />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_labels_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="lbl_books,lbl_authors,lbl_series,lbl_publishers,lbl_contacts"
        />

    <!-- The counts use a larger font than the labels,
         so the former decide position, the labels align to the baselines.
    -->
    <TextView
        android:id="@+id/lbl_books"
        style="@style/About.Label"
        android:maxLines="1"
        android:text="@string/lbl_books"
        app:layout_constraintBaseline_toBaselineOf="@id/book_count"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/lbl_series"
        style="@style/About.Label"
        android:maxLines="1"
        android:text="@string/lbl_series"
        app:layout_constraintBaseline_toBaselineOf="@id/series_count"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/lbl_authors"
        style="@style/About.Label"
        android:maxLines="1"
        android:text="@string/lbl_authors"
        app:layout_constraintBaseline_toBaselineOf="@id/author_count"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/lbl_publishers"
        style="@style/About.Label"
        android:maxLines="1"
        android:text="@string/lbl_publishers"
        app:layout_constraintBaseline_toBaselineOf="@id/publisher_count"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/book_count"
        style="@style/About.Statistic"
        android:layout_marginTop="24dp"
        android:textIsSelectable="true"
        app:layout_constraintStart_toEndOf="@id/barrier_labels_end"
        app:layout_constraintTop_toBottomOf="@id/barrier_header_bottom"
        tools:text="1234"
        />

    <TextView
        android:id="@+id/series_count"
        style="@style/About.Statistic"
        android:textIsSelectable="true"
        app:layout_constraintStart_toEndOf="@id/barrier_labels_end"
        app:layout_constraintTop_toBottomOf="@id/book_count"
        tools:text="234"
        />

    <TextView
        android:id="@+id/author_count"
        style="@style/About.Statistic"
        android:textIsSelectable="true"
        app:layout_constraintStart_toEndOf="@id/barrier_labels_end"
        app:layout_constraintTop_toBottomOf="@id/series_count"
        tools:text="567"
        />

    <TextView
        android:id="@+id/publisher_count"
        style="@style/About.Statistic"
        android:textIsSelectable="true"
        app:layout_constraintStart_toEndOf="@id/barrier_labels_end"
        app:layout_constraintTop_toBottomOf="@id/author_count"
        tools:text="89"
        />

    <TextView
        android:id="@+id/lbl_contacts"
        style="@style/Text.Header"
        android:layout_marginStart="@dimen/field_margin_start"
        android:layout_marginTop="32dp"
        android:text="@string/lbl_about_contact"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/publisher_count"
        />

    <Button
        android:id="@+id/btn_sourcecode_url"
        style="@style/Button.Url.GitHub"
        android:layout_marginStart="@dimen/field_margin_start"
        android:text="@string/lbl_github"
        app:layout_constraintBaseline_toBaselineOf="@id/lbl_contacts"
        app:layout_constraintStart_toEndOf="@id/lbl_contacts"
        />

    <TextView
        android:id="@+id/debug_version"
        style="@style/About.DebugVersion"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="a95 d37"
        />
</androidx.constraintlayout.widget.ConstraintLayout>
