<!--suppress LongLine -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/FragmentRoot.NestedScroller"
    tools:context=".FragmentHostActivity"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/FragmentRoot.ConstraintLayout"
        >

        <TextView
            android:id="@+id/lbl_site"
            style="@style/Text.Header"
            android:text="@string/lbl_select_website"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/col0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.50"
            />

        <!-- seemingly pointless...  but makes it easy to copy/paste
             between portrait and landscape layouts -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/col1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="1"
            />

        <!-- NEWTHINGS: adding a new search engine:
        optional: external id KEY add a RadioButton widget
        and add the name to the ConstraintRadioGroup#constraint_referenced_ids
        and Flow#constraint_referenced_ids.
        -->

        <!--suppress LongLine -->
        <com.hardbacknutter.nevertoomanybooks.core.widgets.ConstraintRadioGroup
            android:id="@+id/sites_group"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="site_amazon,site_bedetheque,site_bibliotece_pl,site_bnf_fr,site_databaze_knih,site_dnb_de,site_goodreads,site_isfdb,site_kb_nl,site_last_dodo_nl,site_open_library,site_strip_info_be"
            tools:ignore="MissingConstraints"
            />

        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/flow_sites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:constraint_referenced_ids="site_amazon,site_bedetheque,site_bibliotece_pl,site_bnf_fr,site_databaze_knih,site_dnb_de,site_goodreads,site_isfdb,site_kb_nl,site_last_dodo_nl,site_open_library,site_strip_info_be"
            app:flow_horizontalAlign="start"
            app:flow_horizontalBias="0.5"
            app:flow_horizontalGap="@dimen/field_margin_inline"
            app:flow_horizontalStyle="packed"
            app:flow_maxElementsWrap="6"
            app:flow_verticalBias="0"
            app:flow_verticalGap="@dimen/field_margin_top"
            app:flow_verticalStyle="packed"
            app:flow_wrapMode="aligned"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lbl_site"
            />

        <RadioButton
            android:id="@+id/site_amazon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/field_margin_start"
            android:text="@string/site_amazon"
            />

        <RadioButton
            android:id="@+id/site_bedetheque"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/field_margin_start"
            android:text="@string/site_bedetheque"
            />

        <RadioButton
            android:id="@+id/site_bibliotece_pl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/field_margin_start"
            android:text="@string/site_bibliotece_pl"
            />

        <RadioButton
            android:id="@+id/site_bnf_fr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/field_margin_start"
            android:text="@string/site_bnf_fr"
            />

        <RadioButton
            android:id="@+id/site_databaze_knih"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/field_margin_start"
            android:text="@string/site_databazeknih_cz"
            />

        <RadioButton
            android:id="@+id/site_dnb_de"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/field_margin_start"
            android:text="@string/site_dnb_de"
            />

        <RadioButton
            android:id="@+id/site_goodreads"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/field_margin_start"
            android:text="@string/site_goodreads"
            />

        <RadioButton
            android:id="@+id/site_isfdb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/field_margin_start"
            android:text="@string/site_isfdb"
            />

        <RadioButton
            android:id="@+id/site_kb_nl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/field_margin_start"
            android:text="@string/site_kb_nl"
            />

        <RadioButton
            android:id="@+id/site_last_dodo_nl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/field_margin_start"
            android:text="@string/site_lastdodo_nl"
            />

        <RadioButton
            android:id="@+id/site_open_library"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/field_margin_start"
            android:text="@string/site_open_library"
            />

        <RadioButton
            android:id="@+id/site_strip_info_be"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/field_margin_start"
            android:text="@string/site_stripinfo_be"
            />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lbl_external_id"
            style="@style/TIL.Text.ExternalId"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/section_margin_top"
            android:hint="@string/lbl_site_book_id"
            app:endIconMode="custom"
            app:layout_constraintEnd_toStartOf="@id/btn_search"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/flow_sites"
            app:layout_constraintWidth_max="216dp"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/external_id"
                style="@style/TIE.Generic"
                android:drawableStart="@drawable/dialpad_24px"
                android:drawablePadding="4dp"
                android:enabled="false"
                android:imeOptions="actionSearch"
                android:inputType="number"
                tools:ignore="Autofill"
                tools:text="OL51566464M"
                />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_search"
            style="@style/Button.Action.Search"
            app:layout_constraintBottom_toBottomOf="@id/lbl_external_id"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/lbl_external_id"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
