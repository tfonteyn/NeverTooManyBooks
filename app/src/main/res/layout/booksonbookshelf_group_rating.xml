<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:viewBindingIgnore="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.hardbacknutter.zratingbar.MaterialRatingBar
        android:id="@+id/rating"
        style="@style/Field.ZRatingBar.Indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:id="@+id/level_book_count"
        style="@style/BoB.Group.Label"
        android:layout_width="wrap_content"
        android:layout_marginStart="@dimen/field_margin_start"
        android:layout_marginEnd="@dimen/field_margin_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cbx_is_complete"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="SelectableText"
        tools:text="#34"
        />

    <!-- Not used, but needed as a space holder to preserve the look of the list. -->
    <ImageView
        android:id="@+id/cbx_is_complete"
        style="@style/Flag.Complete"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/rating"
        app:layout_constraintEnd_toStartOf="@id/ROW_MENU_BTN"
        tools:ignore="ContentDescription"
        tools:visibility="visible"
        />

    <com.google.android.material.button.MaterialButton
        android:id="@id/ROW_MENU_BTN"
        style="@style/Button.MenuPopup.More"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible"
        />
</androidx.constraintlayout.widget.ConstraintLayout>
