<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/RowEditor.Container">

    <LinearLayout
        android:id="@+id/content"
        style="@style/RowEditor.Container.Content"
        android:gravity="center_vertical"
        tools:viewBindingIgnore="true">

        <com.hardbacknutter.zratingbar.MaterialRatingBar
            android:id="@+id/rating"
            style="@style/Field.ZRatingBar.Indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/field_margin_top" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/level_book_count"
            style="@style/BoB.Group.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/field_margin_start"
            android:layout_marginEnd="@dimen/field_margin_start"
            tools:ignore="SelectableText"
            tools:text="#34" />

        <!-- uses visibility="invisible" to preserve the space,
             even when it's not used by the row. -->
        <View
            android:id="@+id/cbx_is_complete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="invisible"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@id/ROW_MENU_BTN"
            style="@style/Button.MenuPopup.More"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>
</FrameLayout>
