<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                  xmlns:app="http://schemas.android.com/apk/res-auto"
                  xmlns:tools="http://schemas.android.com/tools">

    <PreferenceCategory
        android:title="@string/site_biblionet_gr">

        <SwitchPreference
            android:defaultValue="false"
            android:icon="@drawable/barcode_24px"
            android:key="biblionetgr.search.byIsbn.prefer.10"
            android:summaryOff="@string/no"
            android:summaryOn="@string/yes"
            android:title="@string/pt_search_prefer_isbn10" />

        <SwitchPreference
            android:defaultValue="false"
            android:icon="@drawable/tag_24px"
            android:key="biblionetgr.search.tag.prefix_number"
            android:summaryOff="@string/no"
            android:summaryOn="@string/yes"
            android:title="@string/pt_search_tag_use_subject_number"
            />

        <SwitchPreference
            android:defaultValue="true"
            android:icon="@drawable/cloud_download_24px"
            android:key="biblionetgr.resolve.authors.wikidata"
            android:summaryOff="@string/no"
            android:summaryOn="@string/yes"
            tools:title="@string/pt_fetch_author_info_using_site_x" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/lbl_timeouts">
        <SeekBarPreference
            android:defaultValue="20"
            android:icon="@drawable/more_time_24px"
            android:key="biblionetgr.timeout.connect"
            android:max="60"
            android:title="@string/lbl_connection_timeout"
            app:min="3"
            app:showSeekBarValue="true"
            />
        <SeekBarPreference
            android:defaultValue="60"
            android:icon="@drawable/more_time_24px"
            android:key="biblionetgr.timeout.read"
            android:max="120"
            android:title="@string/lbl_read_timeout"
            app:min="3"
            app:showSeekBarValue="true"
            />
    </PreferenceCategory>

    <com.hardbacknutter.nevertoomanybooks.settings.widgets.ExtPreferenceCategory
        android:summary="@string/lbl_troubleshooting_warning"
        android:title="@string/lbl_troubleshooting">
        <SwitchPreference
            android:defaultValue="false"
            android:icon="@drawable/troubleshoot_24px"
            android:key="biblionetgr.logging.http.get"
            android:summaryOff="@string/no"
            android:summaryOn="@string/yes"
            android:title="@string/pt_enable_extra_logging" />

    </com.hardbacknutter.nevertoomanybooks.settings.widgets.ExtPreferenceCategory>

</PreferenceScreen>