<resources>
    <dimen name="cover_list_padding">8dp</dimen>
    <dimen name="cover_details_0_padding">20dp</dimen>
    <dimen name="cover_details_1_padding">20dp</dimen>

    <!-- Multiplier: 7.5 -->
    <dimen name="cover_details_0_width">180dp</dimen>
    <!-- Multiplier: 4 -->
    <dimen name="cover_details_1_width">96dp</dimen>

    <!-- Multiplier: 4.5 -->
    <dimen name="cover_edit_0_width">108dp</dimen>
    <dimen name="cover_edit_1_width">108dp</dimen>

    <integer name="cover_browser_gallery_span_count">3</integer>
    <!-- Multiplier: 4 -->
    <dimen name="cover_browser_gallery_width">96dp</dimen>
    <!-- Multiplier: 10 -->
    <dimen name="cover_browser_preview_width">240dp</dimen>

    <array name="cover_max_width">
        <!-- hidden -->
        <item>0dp</item>
        <!-- small: 4 * 24dp -->
        <item>96dp</item>
        <!-- medium: 5 * 24dp - the default. -->
        <item>120dp</item>
        <!-- large: 6 * 24dp -->
        <item>144dp</item>
        <!-- X-Large: 7 * 24dp -->
        <item>168dp</item>
    </array>
</resources>
