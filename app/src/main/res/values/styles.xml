<!--suppress LongLine -->
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Label for a field (both view and edit screens). -->
    <style name="Label"
           parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/field_margin_top</item>
        <item name="android:layout_marginStart">@dimen/field_margin_start</item>
        <item name="android:textIsSelectable">false</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
    </style>

    <!-- Label for a TextView with a 'check' at the end - used on view screens -->
    <style name="Label.Checked">
        <item name="android:drawablePadding">@dimen/field_margin_inline</item>
        <item name="android:drawableEnd">@drawable/check_24px</item>
        <item name="drawableTint">?attr/colorSecondary</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
    </style>

    <!-- *************************************************************************************** -->
    <!-- Read-only, informative text -->
    <!-- *************************************************************************************** -->
    <style name="Base.Text"
           parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>

    <!-- A single-line text header; at the top of a screen, section, ... -->
    <style name="Text.Header"
           parent="Base.Text">
        <item name="android:layout_marginTop">@dimen/section_margin_top</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="Text.Body"
           parent="Base.Text">
    </style>

    <style name="Text.Error"
           parent="Base.Text">
        <item name="android:textColor">?attr/colorError</item>
    </style>

    <!-- multi-line informational text, usually at the top of a screen -->
    <style name="Text.Info"
           parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">4dp</item>
        <item name="android:drawableStart">@drawable/info_24px</item>
        <item name="android:drawablePadding">@dimen/field_margin_inline</item>
        <item name="android:drawableTint">?attr/colorSecondary</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <!-- A header message which MIMICS the PreferenceCategory style.
         This is for use on screen which themselves MIMIC a preference screen.
    -->
    <style name="Text.Header.PreferenceCategory">
        <item name="android:layout_marginStart">@dimen/preference_header_margin_start</item>
        <!-- NOT textColorSecondary! -->
        <item name="android:textColor">?attr/colorSecondary</item>
    </style>

    <!-- *************************************************************************************** -->
    <!-- Activity navigation drawer/view -->
    <!-- *************************************************************************************** -->
    <style name="NavigationView"
           parent="Widget.Material3.NavigationView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_gravity">start</item>
        <item name="headerLayout">@layout/nav_header_main</item>
    </style>

    <!-- *************************************************************************************** -->
    <!-- Dialogs -->
    <!-- *************************************************************************************** -->

    <!-- The title at the top of a Dialog which has NO toolbar -->
    <style name="Dialog.Header.Title"
           parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- A message (not the body) at the top of a Dialog. -->
    <style name="Dialog.Header.Message"
           parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>

        <item name="android:layout_marginTop">@dimen/section_margin_top</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:layout_marginBottom">48dp</item>

        <item name="android:textIsSelectable">true</item>
    </style>

    <!-- The root view for the Dialog content. -->
    <style name="Dialog.Content"
           parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>

        <item name="android:paddingTop">@dimen/dialogPreferredPaddingTop</item>
        <item name="android:paddingBottom">@dimen/dialogPreferredPaddingBottom</item>
        <item name="android:paddingStart">?attr/dialogPreferredPadding</item>
        <item name="android:paddingEnd">?attr/dialogPreferredPadding</item>

        <item name="layout_behavior">@string/appbar_scrolling_view_behavior</item>
    </style>

    <!-- Container (ConstraintLayout) for the buttons at the bottom of a dialog. -->
    <style name="Dialog.ButtonPanel"
           parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>

        <item name="android:paddingStart">?attr/dialogPreferredPadding</item>
        <item name="android:paddingEnd">?attr/dialogPreferredPadding</item>
        <item name="android:paddingTop">@dimen/app_m3_alert_dialog_action_top_padding</item>
        <item name="android:paddingBottom">@dimen/app_m3_alert_dialog_action_bottom_padding</item>
    </style>

    <!-- Root window (ConstraintLayout) for a floating progress dialog. -->
    <style name="ProgressDialog">
        <item name="android:layout_width">@dimen/progress_width</item>
        <item name="android:layout_height">wrap_content</item>

        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:elevation">@dimen/progress_z</item>
        <item name="android:layout_marginTop">@dimen/progress_margin_top</item>

        <item name="android:background">@drawable/bg_progress_dialog</item>
        <!-- ConstraintLayout is NOT material, so use "android:" -->
        <item name="android:backgroundTint">?attr/colorSurface</item>

        <item name="android:paddingStart">?attr/dialogPreferredPadding</item>
        <item name="android:paddingTop">@dimen/dialogPreferredPaddingTop</item>
        <item name="android:paddingEnd">?attr/dialogPreferredPadding</item>
        <item name="android:paddingBottom">@dimen/dialogPreferredPaddingBottom</item>
    </style>

    <!-- *************************************************************************************** -->

    <!-- NestedScrollView as the root of a Fragment -->
    <style name="FragmentRoot.NestedScroller"
           parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:fillViewport">true</item>
        <item name="layout_behavior">@string/appbar_scrolling_view_behavior</item>
    </style>

    <!-- ConstraintLayout as the root of a Fragment OR immediately inside a NestedScrollView
         Width restricted on larger displays!
    -->
    <!-- BE CAREFUL... USING THIS INSIDE A VIEWPAGER2 WILL NOT CENTER THE LAYOUT -->
    <style name="FragmentRoot.ConstraintLayout"
           parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">@dimen/container_margin</item>
    </style>

    <style name="AuthorRoleCheckBox"
           parent="Widget.App.CheckBox">
        <item name="android:layout_width">@dimen/cbx_fixed_width_author_role</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="ReadProgressBar"
           parent="Widget.Material3.LinearProgressIndicator">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:min">0</item>
        <item name="android:max">100</item>
        <item name="indicatorColor">?attr/colorSecondary</item>
    </style>

    <style name="Badge">
        <!-- colorOnError is what "Widget.Material3.Badge" uses -->
        <item name="android:textColor">?attr/colorOnError</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">20dp</item>
        <item name="android:layout_gravity">top|end</item>
        <item name="android:background">@drawable/badge_background</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>
</resources>
