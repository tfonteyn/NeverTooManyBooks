    <!-- *************************************************************************************** -->
    <!-- ========== booklist style preferences ========== -->
    <!-- *************************************************************************************** -->

    <!-- MultiSelectListPreference - Determines what is show in booklist header -->
    <!-- this is a multi-select, i.e. each item is a checkbox, the user can select any/all -->
    <string-array name="pe_bob_header">
        <item>@string/pv_bob_header_style_name</item>
        <item>@string/pv_bob_header_nr_of_books</item>
        <item>@string/pv_bob_header_filters</item>
        <item>@string/lbl_keywords</item>
    </string-array>
    <!-- multi-select: use bitmask values: 1,2,4,8,...-->
    <string-array name="pv_bob_header">
        <item>8</item>
        <item>1</item>
        <item>16</item>
        <item>4</item>
    </string-array>

    <!-- MultiSelectListPreference - Determines which author type is considered
         the primary author of a book -->
    <!-- Mainly of interest for comics (e.g. writer, artist). See Author class for the values. -->
    <!-- this is a multi-select, i.e. each item is a checkbox, the user can select any/all -->
    <string-array name="pe_author_type">
        <item>@string/lbl_author_type_writer</item>
        <item>@string/lbl_author_type_artist</item>
    </string-array>
    <!-- multi-select: use bitmask values: 1,2,4,8,...-->
    <string-array name="pv_author_type">
        <item>1</item>
        <item>4096</item>
    </string-array>
