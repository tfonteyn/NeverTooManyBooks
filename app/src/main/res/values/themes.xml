<!--
    The standard attributes that make up a complete theme.
    https://developer.android.com/reference/android/R.styleable.html#Theme

    Material styles etc.
    https://medium.com/androiddevelopers/migrating-to-material-components-for-android-ec6757795351

    Using The Color Theming System:
    https://m3.material.io/libraries/mdc-android/color-theming


    Note that the "buttonBar*Style" attributes must be added at several places,
     as they don't seem to be inherited from the main Theme.

    =====================================================================================
     2026-05-17: the migration to Material3Expressive
     In the Views system, the only components that actually got dedicated
     Widget.Material3Expressive.* parent styles are:

    - Buttons (Widget.Material3Expressive.Button.*)
    - Icon Buttons (Widget.Material3Expressive.IconButton.*)
    - Floating Action Buttons (Widget.Material3Expressive.ExtendedFloatingActionButton.*)
    - Sliders
    - Progress Indicators (Circular/Linear) ..and the Circular is deprecated,
      to be replaced with com.google.android.material.loadingindicator.LoadingIndicator.
-->
<!--suppress LongLine -->
<resources>
    <!-- Top level Theme for the startup activity so it looks like a dialog as intended. -->
    <style name="Theme.App.Startup"
           parent="Theme.Material3.DayNight.Dialog">
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Top level Theme to be used in AndroidManifest.xml-->
    <style name="Theme.App"
           parent="Base.Theme.App">
        <item name="colorPrimary">@color/m3blue_grey_40</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/m3blue_grey_90</item>
        <item name="colorOnPrimaryContainer">@color/m3blue_grey_10</item>
        <item name="colorPrimaryInverse">@color/m3blue_grey_80</item>

        <item name="colorSecondary">@color/m3teal_40</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/m3teal_90</item>
        <item name="colorOnSecondaryContainer">@color/m3teal_10</item>

        <item name="android:colorBackground">@color/m3grey_99</item>
        <item name="colorOnBackground">@color/m3grey_10</item>

        <item name="colorSurface">@color/m3grey_99</item>
        <item name="colorOnSurface">@color/m3grey_10</item>
        <item name="colorSurfaceVariant">@color/m3grey_90</item>
        <item name="colorOnSurfaceVariant">@color/m3grey_30</item>
        <item name="colorSurfaceInverse">@color/m3grey_20</item>
        <item name="colorOnSurfaceInverse">@color/m3grey_90</item>

        <item name="colorOutline">@color/m3grey_40</item>

        <item name="colorError">@color/m3red_40</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/m3red_90</item>
        <item name="colorOnErrorContainer">@color/m3red_10</item>

        <!-- Optionally enabled by a user preference setting. -->
        <item name="dynamicColorThemeOverlay">
            @style/ThemeOverlay.Material3Expressive.DynamicColors.Light
        </item>
    </style>

    <!-- Base theme - used by both Day and Night themes. -->
    <style name="Base.Theme.App"
           parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <!-- Material3 style attributes -->
        <item name="bottomSheetDragHandleStyle">@style/Widget.App.BottomSheetDragHandle</item>
        <item name="checkboxStyle">@style/Widget.App.CheckBox</item>
        <item name="chipGroupStyle">@style/Widget.App.ChipGroup</item>
        <item name="circularProgressIndicatorStyle">
            @style/Widget.App.CircularProgressIndicator
        </item>
        <item name="extendedFloatingActionButtonStyle">
            @style/Widget.App.ExtendedFloatingActionButton
        </item>
        <item name="floatingActionButtonStyle">@style/Widget.App.FloatingActionButton</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.App.LinearProgressIndicator</item>
        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>
        <item name="materialSwitchStyle">@style/Widget.App.Switch</item>
        <item name="radioButtonStyle">@style/Widget.App.RadioButton</item>
        <item name="recyclerViewStyle">@style/Widget.App.RecyclerView</item>
        <item name="sliderStyle">@style/Widget.App.Slider</item>
        <item name="snackbarTextViewStyle">@style/Widget.App.Snackbar.TextView</item>
        <item name="tabStyle">@style/Widget.App.TabLayout</item>

        <item name="android:fastScrollThumbDrawable">@drawable/fastscroll_thumb</item>
        <item name="android:fastScrollTrackDrawable">@drawable/fastscroll_track</item>

        <!-- We MUST set these separately! Just setting the common buttonBarButtonStyle is NOT enough -->
        <item name="buttonBarButtonStyle">@style/Widget.App.DialogButtonBarButtons</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.DialogButtonBarButtons</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.DialogButtonBarButtons</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.App.DialogButtonBarButtons.Flush
        </item>

        <!-- Material3 theme OVERLAYS! -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>

        <!-- Date(range) picker - Dialog styling. -->
        <item name="materialCalendarTheme">
            @style/ThemeOverlay.App.MaterialCalendarTheme
        </item>
        <!-- Date(range) picker - Fullscreen styling. -->
        <item name="materialCalendarFullscreenTheme">
            @style/ThemeOverlay.App.MaterialCalendarFullscreenTheme
        </item>

        <!-- Chip styles as attributes makes it easier to add chips from code -->
        <item name="appChipFilterStyle">@style/Widget.Material3.Chip.Filter</item>
        <item name="appChipInputStyle">@style/Widget.Material3.Chip.Input</item>
    </style>

    <!-- *************************************************************************************** -->

    <style name="ThemeOverlay.App.Toolbar"
           parent="ThemeOverlay.Material3Expressive.Toolbar.Surface">
        <!-- Force the icons to be visible... as by default Android seems to
             give them such a bad contrast you can barely see them. -->
        <item name="colorControlNormal">?attr/colorOnSurface</item>
    </style>

    <style name="ThemeOverlay.App.TabLayout"
           parent="">
        <!-- selected -->
        <item name="colorPrimary">?attr/colorSecondary</item>
    </style>

    <style name="ThemeOverlay.App.CheckBox"
           parent="">
        <!-- Container: checked -->
        <item name="colorPrimary">?attr/colorSecondary</item>
    </style>

    <style name="ThemeOverlay.App.RadioButton"
           parent="">
        <!-- checked -->
        <item name="colorPrimary">?attr/colorSecondary</item>
    </style>

    <style name="ThemeOverlay.App.Switch"
           parent="">
        <!-- track checked state. -->
        <item name="colorPrimary">?attr/colorSecondary</item>
        <!-- thumb unchecked state. -->
        <item name="colorOutline">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="ThemeOverlay.App.MaterialAlertDialog"
           parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">
            @style/Widget.App.MaterialAlertDialogTitleTextStyle
        </item>

        <item name="buttonBarButtonStyle">@style/Widget.App.DialogButtonBarButtons</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.DialogButtonBarButtons</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.DialogButtonBarButtons</item>
        <item name="buttonBarNeutralButtonStyle">
            @style/Widget.App.DialogButtonBarButtons.Flush
        </item>
    </style>
    <style name="Widget.App.MaterialAlertDialogTitleTextStyle"
           parent="MaterialAlertDialog.Material3Expressive.Title.Text">
        <!-- Original was textAppearanceHeadlineSmall, which uses 24sp.
             The textAppearanceTitleMedium uses 16sp. -->
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>

    <style name="ThemeOverlay.App.MaterialCalendarTheme"
           parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="buttonBarButtonStyle">@style/Widget.App.DialogButtonBarButtons</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.DialogButtonBarButtons</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.DialogButtonBarButtons</item>
        <item name="buttonBarNeutralButtonStyle">
            @style/Widget.App.DialogButtonBarButtons.Flush
        </item>
    </style>

    <style name="ThemeOverlay.App.MaterialCalendarFullscreenTheme"
           parent="ThemeOverlay.Material3.MaterialCalendar.Fullscreen">

        <!-- FIXME: The intention was to style the 'save' button' as an icon-only button.
              but it seems impossible to remove the button text from the fullscreen style
              without also removing it from the dialog style where it MUST be shown.
        -->
        <!--  <item name="materialCalendarHeaderConfirmButton">-->
        <!--      @style/ThemeOverlay.App.MaterialCalendarFullscreenTheme.MaterialCalendarHeaderConfirmButton-->
        <!--  </item>-->
    </style>

    <!-- The "Save" button in the header (toolbar).-->
    <style name="ThemeOverlay.App.MaterialCalendarFullscreenTheme.MaterialCalendarHeaderConfirmButton"
           parent="Toolbar.Button">
        <!-- setting the text of the button here has NO effect, as it will ALWAYS be overwritten
             from the google material code. -->
        <item name="icon">@drawable/save_24px</item>
    </style>
</resources>
