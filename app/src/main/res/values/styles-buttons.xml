<resources>
    <!-- *************************************************************************************** -->
    <!-- Generic buttons -->
    <!-- *************************************************************************************** -->

    <!-- a base style as a fix for the blob-like size of a Material3Expressive IconButton -->
    <style name="Base.RoundIconButton"
           parent="Widget.Material3Expressive.Button.IconButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <!-- Make the button round. -->
        <item name="android:paddingVertical">0dp</item>
        <item name="android:paddingHorizontal">0dp</item>
        <!-- This is not a text button...
              but we need to use this to override yet another google [bleep] -->
        <item name="iconGravity">textStart</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="backgroundTint">?attr/colorSurfaceVariant</item>
    </style>

    <!-- The TextInputLayout view as the equivalent of a Spinner for menu selections. -->
    <style name="Button.DropdownMenu"
           parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- A button in a list of action-options.

         In theory the parent should be one of the Widget.Material3.Button.Icon'd
         as we use a text+icon; but that looks awful.
    -->
    <style name="Button.Menu"
           parent="Widget.Material3Expressive.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">?attr/listPreferredItemHeight</item>
        <item name="android:layout_marginStart">@dimen/field_margin_start</item>
        <item name="android:textAppearance">@style/Button.Menu.Label</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:maxLines">3</item>
        <item name="android:gravity">start|center_vertical</item>
        <!-- icon space is 48dp, minus the icon of 24dp, divided by 2 -->
        <item name="iconPadding">12dp</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- textAppearance; not a full style -->
    <style name="Button.Menu.Label"
           parent="TextAppearance.Material3.TitleMedium">
    </style>

    <!-- A button to create something.
         Meant to be placed on the 'end' & 'bottom' of a form.
    -->
    <style name="Button.Action.Create"
           parent="Widget.Material3Expressive.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:text">@string/action_create</item>
    </style>

    <!-- A button to start a search.
         Meant to be placed on the 'end' & 'bottom' of a form.
    -->
    <style name="Button.Action.Search"
           parent="Widget.Material3Expressive.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:text">@string/action_search</item>
        <item name="icon">@drawable/search_24px</item>
    </style>

    <!-- The "show toc" button. -->
    <style name="Button.Action.OpenToc"
           parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/btn_open_toc_text_size</item>
        <item name="android:contentDescription">@string/action_show_toc_long</item>
    </style>

    <!-- A small 'help' button next to an option. -->
    <style name="Button.InfoPopup"
           parent="Base.RoundIconButton">
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:padding">0dp</item>
        <item name="icon">@drawable/help_24px</item>
    </style>

    <!-- Generic Context menu button with the 3-dot vertical line icon. -->
    <style name="Button.MenuPopup.More"
           parent="Base.RoundIconButton">
        <item name="icon">@drawable/more_vert_24px</item>
        <item name="android:contentDescription">@string/action_show_options</item>
    </style>

    <style name="Base.Button.Grid"
           parent="Base.RoundIconButton">
        <!-- full size buttons are too heavy in grid.
             These are a little harder to tap, but until we receive an actual user complaint...
             The assumption is that most users will disable these buttons anyhow. -->
        <item name="android:scaleX">@dimen/context_menu_button_scale</item>
        <item name="android:scaleY">@dimen/context_menu_button_scale</item>
    </style>

    <style name="Button.Grid.Details"
           parent="Base.Button.Grid">
        <item name="icon">@drawable/fullscreen_24px</item>
        <item name="android:contentDescription">@string/pe_bob_cover_click_details</item>
    </style>

    <style name="Button.Grid.More"
           parent="Base.Button.Grid">
        <item name="icon">@drawable/more_vert_24px</item>
        <item name="android:contentDescription">@string/action_show_options</item>
    </style>

    <!-- *************************************************************************************** -->

    <!-- A button which will take the user to an external website. -->
    <style name="Button.Url"
           parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="icon">@drawable/link_24px</item>
        <item name="iconGravity">textStart</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Button.Url.GitHub">
        <item name="icon">@drawable/github_24px</item>
        <item name="android:layout_width">160dp</item>
    </style>

</resources>