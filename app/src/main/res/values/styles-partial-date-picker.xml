<resources>

    <style name="Base.Button.PartialDatePicker"
           parent="Widget.Material3Expressive.Button.TextButton">
        <item name="android:checkable">true</item>

        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>

        <!-- "Widget.MaterialComponents.MaterialCalendar.Day" -->
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/partial_date_picker_item_text_color</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>

        <item name="android:width">@dimen/partial_date_picker_day_width</item>
        <item name="android:height">@dimen/partial_date_picker_day_height</item>

        <item name="android:insetTop">@dimen/partial_date_picker_day_vertical_padding</item>
        <item name="android:insetBottom">@dimen/partial_date_picker_day_vertical_padding</item>
        <item name="android:insetLeft">@dimen/partial_date_picker_day_horizontal_padding</item>
        <item name="android:insetRight">@dimen/partial_date_picker_day_horizontal_padding</item>

        <item name="cornerSize">@dimen/partial_date_picker_day_corner</item>
        <item name="itemStrokeColor">@color/partial_date_picker_item_stroke_color</item>
        <item name="itemShapeAppearance">?attr/shapeAppearanceSmallComponent</item>
        <item name="backgroundTint">@color/partial_date_picker_item_fill_color</item>

        <!-- "Widget.MaterialComponents.MaterialCalendar.Day"
              also set "itemStrokeWidth" but we can't use a selector for that
              and the way the material library does this is huge overkill.
        selected: <item name="itemStrokeWidth">0dp</item>
        unselected: <item name="itemStrokeWidth">1dp</item>
        -->
    </style>

    <style name="PartialDatePicker.Day"
           parent="Base.Button.PartialDatePicker">
        <item name="android:layout_width">@dimen/partial_date_picker_day_width</item>
        <item name="android:layout_height">@dimen/partial_date_picker_day_height</item>
    </style>

    <style name="PartialDatePicker.Month"
           parent="Base.Button.PartialDatePicker">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">@dimen/partial_date_picker_day_height</item>
    </style>

    <style name="PartialDatePicker.Year"
           parent="Base.Button.PartialDatePicker">
        <item name="android:layout_width">@dimen/partial_date_picker_year_width</item>
        <item name="android:layout_height">@dimen/partial_date_picker_year_height</item>
        <item name="android:gravity">center_horizontal|center_vertical</item>
    </style>


</resources>